# Bug Report Server Configuration

# Server settings
PORT=3100
METRICS_HOST=0.0.0.0

# Database
DB_PATH=/data/bug-reports.db

# Authentication
BUG_REPORT_TOKEN=your-secure-token-here

# HMAC Signature Verification (optional but recommended)
# Format: "agentId:secret,agentId2:secret2" or "*:secret" for wildcard
# Example: "agenium-search/*:hmac-secret-123,agenium/*:hmac-secret-456"
BUG_SERVER_HMAC_SECRETS=

# Timestamp tolerance for replay protection (default: 5 minutes)
TIMESTAMP_TOLERANCE_MS=300000
