{
  "name": "agenium",
  "version": "0.2.3",
  "description": "DNS of the Agent Web — identity, discovery & communication for AI agents. MCP-compatible agent:// protocol with mTLS, trust scores & capability search.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "agenium": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "scripts/postinstall.js"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "node --test dist/**/*.test.js",
    "e2e": "npx tsx e2e-test.ts",
    "test:integration": "npx tsx test/integration-marketplace.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test",
    "postinstall": "node scripts/postinstall.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "agent",
    "ai-agent",
    "a2a",
    "agent-to-agent",
    "mcp",
    "model-context-protocol",
    "agent-discovery",
    "agent-protocol",
    "agent-dns",
    "agent-identity",
    "agent-communication",
    "ai-tools",
    "llm-tools",
    "mcp-server",
    "mcp-bridge",
    "multi-agent",
    "agent-framework"
  ],
  "author": "Agenium Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Aganium/agenium.git"
  },
  "bugs": {
    "url": "https://github.com/Aganium/agenium/issues"
  },
  "homepage": "https://agenium.net",
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "@noble/ed25519": "^3.0.0",
    "better-sqlite3": "^12.6.2"
  }
}
